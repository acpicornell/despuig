---
import '../styles/global.css';
import { url } from '../lib/url.mjs';

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · Mapa del Cardenal Despuig` : 'El mapa del Cardenal Despuig (1785)';
const desc = description ?? 'Els pobles i els milers de topònims del mapa de Mallorca del Cardenal Antoni Despuig, gravat el 1785.';

const path = Astro.url.pathname.replace(/\/$/, '');
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const nav = [
  { href: url(''), label: 'Inici', match: base === '' ? '' : base },
  { href: url('gravat'), label: 'El gravat', match: base + '/gravat' },
  { href: url('pobles'), label: 'Els pobles', match: base + '/pobles' },
  { href: url('toponims'), label: 'Topònims', match: base + '/toponims' },
  { href: url('mapa'), label: 'Mapa', match: base + '/mapa' },
  { href: url('estadistiques'), label: 'Estadístiques', match: base + '/estadistiques' },
  { href: url('metode'), label: 'El mètode', match: base + '/metode' },
];
const isCurrent = (m) => (m === (base || '') ? path === (base || '') : path === m || path.startsWith(m + '/'));
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip">Salta al contingut</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('')}>Mapa de Mallorca · Antoni Despuig · 1785</a>
        <nav class="nav" aria-label="Principal">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.match) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <strong>El mapa del Cardenal Despuig</strong> — divulgació dels pobles i la toponímia
          del <em>Mapa de la Isla de Mallorca</em> (Antoni Despuig, gravat el 1785).
        </div>
        <div class="muted">
          Imatge mestra: Biblioteca Virtual de Defensa, edició original de 1785
          (sign. Ar.G bis-T.3-C.1-023bis), CC BY 4.0.
        </div>
      </div>
    </footer>
  </body>
</html>
