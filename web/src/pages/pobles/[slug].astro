---
import Base from '../../layouts/Base.astro';
import data from '../../data/pobles.json';
import { url } from '../../lib/url.mjs';

export function getStaticPaths() {
  const ordered = [...data.pobles].sort((a, b) => a.id - b.id);
  return ordered.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      poble: p,
      prev: ordered[(i - 1 + ordered.length) % ordered.length],
      next: ordered[(i + 1) % ordered.length],
    },
  }));
}

const { poble: p, prev, next } = Astro.props;

// Punts del mini-mapa: el poble + els llogarets dependents amb coords (gcps/NGIB).
const punts = [];
if (p.geo) punts.push({ nom: p.nom, lat: p.geo.lat, lng: p.geo.lng, main: true });
for (const d of p.dependents) {
  if (d.geo) punts.push({ nom: d.nom, lat: d.geo.lat, lng: d.geo.lng, main: false });
}
const kicker = p.esCapital ? "Capital de l'illa" : 'Vinyeta gravada · 1785';

// Dades factuals com a línia de metadades compacta (sense caixes).
const fets = [
  p.anyVila ? { k: 'Vila des de', v: p.anyVila } : null,
  p.anyCiutat ? { k: 'Ciutat des de', v: p.anyCiutat } : null,
  p.veins != null ? { k: 'Veïns (1785)', v: p.veins.toLocaleString('ca-ES') } : null,
  p.animes != null ? { k: 'Ànimes', v: p.animes.toLocaleString('ca-ES') } : null,
].filter(Boolean);
---
<Base title={p.nom} description={p.resumCat}>
  <article class="wrap fitxa">
    <nav class="breadcrumb"><a href={url('pobles')}>← Tots els pobles</a></nav>

    <header class="fitxa__head">
      <div>
        <p class="kicker">{kicker}</p>
        <h1>{p.nom}</h1>

        {fets.length > 0 && (
          <dl class="fets">
            {fets.map((f) => (<><dt>{f.k}</dt><dd>{f.v}</dd></>))}
          </dl>
        )}

        {(p.nomArab || p.nomAntic || p.nomGravat) && (
          <p class="muted noms">
            {p.nomGravat && <span>Grafia gravada: <em>{p.nomGravat}</em></span>}
            {p.nomArab && <span>Nom andalusí: <em>{p.nomArab}</em></span>}
            {p.nomAntic && <span>Nom antic: <em>{p.nomAntic}</em></span>}
          </p>
        )}

        {p.collites.length > 0 && (
          <p class="collites"><span class="muted">Collites:</span> {p.collites.map((c) => <span class="tag">{c}</span>)}</p>
        )}

        {p.fires && <p class="fires"><span class="muted">Fires:</span> {p.fires}</p>}
      </div>

      {punts.length > 0 && (
        <aside class="locator-wrap">
          <div id="locator" data-punts={JSON.stringify(punts)} role="img" aria-label={`Mapa amb la ubicació de ${p.nom}`}></div>
          <p class="muted small">{p.geoAprox
            ? 'Localització aproximada del nucli (NGIB); la posició exacta sobre el gravat arribarà amb la georeferenciació del full.'
            : 'Ubicació segons el Nomenclàtor Geogràfic de les Illes Balears (NGIB).'}</p>
        </aside>
      )}
    </header>

    <div class="cols">
      <div>
        <blockquote class="original">{p.textOriginal}</blockquote>

        {p.dependents.length > 0 && (
          <div class="dependents">
            <h2>Llogarets dependents</h2>
            <ul>
              {p.dependents.map((d) => (
                <li><strong>{d.nom}</strong> — {d.veins} veïns, {d.animes} ànimes</li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <figure class="gravat">
        {p.vinyeta
          ? <img src={url(`vinetes/${p.vinyeta}.jpg`)} alt={`Vista gravada de ${p.nom} al mapa de Despuig`} />
          : <div class="noimg">Vinyeta no disponible</div>}
        <figcaption>Gravat original de la vinyeta de {p.nom}.</figcaption>
      </figure>
    </div>

    <nav class="pager">
      <a href={url(`pobles/${prev.slug}`)}>← {prev.nom}</a>
      <a href={url(`pobles/${next.slug}`)}>{next.nom} →</a>
    </nav>
  </article>

  {punts.length > 0 && (
    <>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      <script is:inline>
        (function () {
          const el = document.getElementById('locator');
          if (!el || !window.L) return;
          const punts = JSON.parse(el.dataset.punts);
          const main = punts.find((p) => p.main) || punts[0];
          const map = L.map(el, { scrollWheelZoom: false, attributionControl: true }).setView([main.lat, main.lng], 11);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            attribution: '© OpenStreetMap',
          }).addTo(map);
          const group = [];
          punts.forEach((pt) => {
            const m = L.marker([pt.lat, pt.lng]).addTo(map)
              .bindPopup(pt.main ? '<strong>' + pt.nom + '</strong>' : pt.nom + ' (dependent)');
            group.push(m.getLatLng());
          });
          if (group.length > 1) map.fitBounds(L.latLngBounds(group).pad(0.4));
        })();
      </script>
    </>
  )}
</Base>

<style>
  .fitxa { padding-top: 1.2rem; }
  .breadcrumb { margin-bottom: 1.6rem; font-size: .95rem; }
  .kicker { font-family: var(--display); letter-spacing: .1em; text-transform: uppercase; font-size: .78rem; color: var(--sepia); margin: 0 0 .2rem; }
  .fitxa__head { display: grid; grid-template-columns: 2fr 3fr; gap: 2.4rem; align-items: start; }
  .fitxa__head h1 { margin: 0 0 1rem; }

  .fets { display: grid; grid-template-columns: 1fr auto; align-items: center; margin: 0 0 1.2rem; border-bottom: 1px solid var(--line); }
  .fets dt { font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-soft); padding: .55rem 0; border-top: 1px solid var(--line); }
  .fets dd { margin: 0; text-align: right; font-family: var(--display); font-size: 1.45rem; color: var(--accent); line-height: 1; padding: .5rem 0; border-top: 1px solid var(--line); }

  .noms.noms { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: .92rem; margin: 0 0 .8rem; }
  .collites { margin: 0 0 .5rem; }
  .fires { margin: 0; font-size: .95rem; }
  .gravat { margin: 0; border: 1px solid var(--line); background: #fff; box-shadow: 0 3px 14px var(--shadow); }
  .gravat img { width: 100%; display: block; }
  .gravat .noimg { aspect-ratio: 4 / 3; display: grid; place-items: center; color: var(--ink-soft); font-style: italic; }
  .gravat figcaption { padding: .5rem .7rem; font-size: .82rem; color: var(--ink-soft); font-style: italic; }

  .cols { display: grid; grid-template-columns: 2fr 3fr; gap: 2.4rem; align-items: start; margin-top: 2rem; }
  .cols h2 { margin-top: 0; }
  .original {
    font-size: 1.12rem; line-height: 1.65; margin: 0; padding: 1.1rem 1.3rem;
    border-left: 4px solid var(--accent); background: rgba(255,255,255,.4);
    font-style: italic; color: var(--ink);
  }
  .dependents ul { padding-left: 1.1rem; }
  .small { font-size: .85rem; }
  #locator { height: 320px; border: 1px solid var(--line); border-radius: 4px; }

  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; border-top: 1px solid var(--line); padding-top: 1rem; font-family: var(--display); }

  @media (max-width: 820px) {
    .fitxa__head, .cols { grid-template-columns: 1fr; }
  }
</style>
