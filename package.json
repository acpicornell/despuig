{
  "name": "mapa-despuig",
  "type": "module",
  "version": "0.1.0",
  "description": "Web divulgativa del mapa de Mallorca del Cardenal Despuig (1785/1829)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "vinetas": "node scripts/crop-vinetas.mjs",
    "dzi": "node scripts/build-dzi.mjs",
    "toponims:link": "nix-shell scripts/toponims/mapkurator/shell.nix --run 'python3 scripts/toponims/mapkurator/link_labels.py'",
    "toponims:recog": "nix-shell scripts/toponims/mapkurator/shell.nix --run 'python3 scripts/toponims/mapkurator/build_recog_montages.py'",
    "toponims:build": "nix-shell scripts/toponims/mapkurator/shell.nix --run 'python3 scripts/toponims/mapkurator/build_toponims.py'",
    "toponims:clean": "nix-shell scripts/toponims/mapkurator/shell.nix --run 'python3 scripts/toponims/mapkurator/clean_toponims.py'",
    "toponims:table": "nix-shell scripts/toponims/shell.nix --run 'python3 scripts/toponims/mapkurator/to_table.py'",
    "toponims:georef": "nix-shell scripts/toponims/shell.nix --run 'python3 scripts/toponims/mapkurator/georef.py'",
    "toponims:georef-bootstrap": "nix-shell scripts/toponims/shell.nix --run 'python3 scripts/toponims/mapkurator/georef_bootstrap.py'",
    "toponims:ngib-fetch": "node scripts/toponims/ngib-fetch.mjs",
    "toponims:ngib-match": "nix-shell scripts/toponims/shell.nix --run 'python3 scripts/toponims/ngib_match.py'",
    "toponims:vinetes": "node scripts/toponims/vinetes-server.mjs"
  },
  "dependencies": {
    "astro": "^4.16.18"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
