---
import Base from '../../layouts/Base.astro';
import data from '../../data/pobles.json';
import { url } from '../../lib/url.mjs';

const pobles = [...data.pobles].sort((a, b) => a.nom.localeCompare(b.nom, 'ca'));
const bordeLabel = { superior: 'marge superior', inferior: 'marge inferior', izquierdo: 'marge esquerre', derecho: 'marge dret' };
---
<Base title="Els pobles" description="Les 34 vinyetes de pobles del mapa del Cardenal Despuig, amb les seves vistes gravades i dades de 1829.">
  <section class="wrap">
    <h1>Els 34 pobles</h1>
    <p class="lede">Cada poble apareix al mapa amb una vista gravada i una breu ressenya. Tria'n un per veure'n el detall.</p>

    <div class="grid">
      {pobles.map((p) => (
        <a class="poble card" href={url(`pobles/${p.slug}`)}>
          <div class="thumb"><img src={url(`vinetas/${p.slug}.jpg`)} alt={`Vista gravada de ${p.nom}`} loading="lazy" /></div>
          <div class="meta">
            <h2>{p.nom}</h2>
            <p class="muted">
              {p.animes ? `${p.animes.toLocaleString('ca-ES')} ànimes` : 'cens incert'}
              · {bordeLabel[p.borde]}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
  .poble { text-decoration: none; color: inherit; overflow: hidden; transition: transform .12s, box-shadow .12s; }
  .poble:hover { transform: translateY(-3px); box-shadow: 0 6px 18px var(--shadow); }
  .thumb { aspect-ratio: 4 / 3; overflow: hidden; background: #fff; border-bottom: 1px solid var(--line); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .meta { padding: .7rem .9rem 1rem; }
  .meta h2 { margin: 0 0 .2rem; font-size: 1.25rem; color: var(--ink); }
  .meta p { margin: 0; font-size: .9rem; }
</style>
