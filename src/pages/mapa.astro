---
import Base from '../layouts/Base.astro';
import data from '../data/pobles.json';
import { cellRect, IMG } from '../lib/frame.mjs';
import { url } from '../lib/url.mjs';

// Superposicions en coordenades normalitzades d'OpenSeadragon (x i y dividits per l'amplada).
const overlays = data.pobles.map((p) => {
  const r = cellRect(p.borde, p.ordre);
  return {
    slug: p.slug, nom: p.nom,
    x: r.x / IMG.w, y: r.y / IMG.w, w: r.w / IMG.w, h: r.h / IMG.w,
  };
});
const config = { dzi: url('map/mapa.dzi'), fallback: url('map/T0023524.jpg'), W: IMG.w, H: IMG.h, base: url('pobles/') };
---
<Base title="Mapa interactiu" description="Explora el mapa de Mallorca del Cardenal Despuig en alta resolució, amb zoom sobre els seus milers de topònims.">
  <section class="wrap intro">
    <h1>El mapa amb zoom</h1>
    <p class="lede">
      Amplia per explorar els milers de topònims, possessions i accidents del litoral que Muntaner
      gravà sobre el mapa. Les viñetas del marc són clicables: porten a la fitxa de cada poble.
    </p>
  </section>

  <div id="osd" data-config={JSON.stringify(config)} data-overlays={JSON.stringify(overlays)}></div>
  <p class="wrap muted small">Controls: roda del ratolí o botons per ampliar; arrossega per moure't.</p>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/openseadragon/4.1.0/openseadragon.min.js"></script>
  <script is:inline>
    (function () {
      const host = document.getElementById('osd');
      if (!host || !window.OpenSeadragon) return;
      const cfg = JSON.parse(host.dataset.config);
      const overlays = JSON.parse(host.dataset.overlays);
      const viewer = OpenSeadragon({
        element: host,
        prefixUrl: 'https://cdnjs.cloudflare.com/ajax/libs/openseadragon/4.1.0/images/',
        tileSources: cfg.dzi,
        showNavigator: true,
        navigatorPosition: 'TOP_RIGHT',
        gestureSettingsMouse: { clickToZoom: false },
        minZoomImageRatio: 0.8,
        maxZoomPixelRatio: 2,
      });
      // si falla la càrrega del DZI, fem servir la imatge única com a alternativa
      viewer.addHandler('open-failed', function () {
        viewer.open({ type: 'image', url: cfg.fallback });
      });
      viewer.addHandler('open', function () {
        overlays.forEach(function (o) {
          const a = document.createElement('a');
          a.href = cfg.base + o.slug;
          a.className = 'osd-spot';
          a.title = o.nom;
          a.setAttribute('aria-label', o.nom);
          viewer.addOverlay({ element: a, location: new OpenSeadragon.Rect(o.x, o.y, o.w, o.h) });
        });
      });
    })();
  </script>
</Base>

<style>
  .intro { padding-top: 1.5rem; }
  #osd {
    width: 100%; height: 78vh; min-height: 460px;
    background: #d9cba8; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    margin: 1rem 0 .5rem;
  }
  .small { font-size: .85rem; }
  :global(.osd-spot) {
    display: block; border: 2px solid transparent; border-radius: 2px;
    transition: background-color .15s, border-color .15s;
  }
  :global(.osd-spot:hover) { background-color: rgba(138,51,36,.18); border-color: var(--accent); }
</style>
