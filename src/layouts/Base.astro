---
import '../styles/global.css';
import { url } from '../lib/url.mjs';

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · Mapa del Cardenal Despuig` : 'El mapa del Cardenal Despuig (1785)';
const desc = description ?? 'Els 34 pobles de Mallorca a les viñetas del mapa del Cardenal Antoni Despuig, gravat el 1785.';

const path = Astro.url.pathname.replace(/\/$/, '');
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const nav = [
  { href: url(''), label: 'Inici', match: base === '' ? '' : base },
  { href: url('pobles'), label: 'Els pobles', match: base + '/pobles' },
  { href: url('mapa'), label: 'Mapa interactiu', match: base + '/mapa' },
  { href: url('dades'), label: 'Dades', match: base + '/dades' },
  { href: url('sobre'), label: 'Sobre el mapa', match: base + '/sobre' },
];
const isCurrent = (m) => (m === (base || '') ? path === (base || '') : path === m || path.startsWith(m + '/'));
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('')}>
          El mapa del Cardenal Despuig
          <small>Mallorca · 1785 / 1829</small>
        </a>
        <nav class="nav" aria-label="Principal">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.match) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <strong>El mapa del Cardenal Despuig</strong> — divulgació de les 34 viñetas de pobles
          del <em>Mapa de la Isla de Mallorca</em> (reedició reduïda, dades censals de 1829).
        </div>
        <div class="muted">
          Imatge mestra: Instituto Geográfico Nacional (fitxa 32-H-18), domini públic ·
          <a href={url('sobre')}>fonts i llicència</a>.
        </div>
      </div>
    </footer>
  </body>
</html>
