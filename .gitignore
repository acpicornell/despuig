# build output / deps / caches
dist/
.astro/
node_modules/
__pycache__/
.DS_Store
npm-debug.log*

# local Claude Code settings
.claude/

# web (per-sheet): regenerable assets (npm run vinetes / hero / map)
web/public/vinetes/
web/public/hero/
web/public/map/
web/public/sheets/

# raw master + source images — large; Biblioteca Virtual de Defensa (CC BY 4.0), not versioned
data/jpg/
# copyrighted PDFs
data/pdf/

# NGIB gazetteer corpus — large, regenerable with scripts/toponims/ngib-fetch.mjs
data/toponims/ngib/llocs.json

# mapKurator: model weights + input/output tiles (large, regenerable)
data/toponims/mapkurator/
# third-party spotter clone (re-cloned by run.sh)
scripts/toponims/mapkurator/vendor/

# per-sheet review tool + GCP-build intermediates (regenerable; gcps-<q>.json IS versioned)
data/toponims/*/review-crops/
data/toponims/*/review-data.json
data/toponims/*/gcp-crops/
data/toponims/*/gcp-dots.json
data/toponims/*/*-overlay.png

# local backups of superseded curation
*.superseded

# review-server atomic-write artefacts (rolling .bak + temp on every save)
data/toponims/*/curation.json.bak
data/toponims/*/curation.json.tmp
