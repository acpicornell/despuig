# build output / deps / caches
dist/
.astro/
node_modules/
__pycache__/
.DS_Store
npm-debug.log*

# local Claude Code settings
.claude/

# The built deploy assets — web/public/{map,sheets,vinetes,hero} — ARE versioned.
# They are generated by `npm run map|sheets|vinetes|hero` from the raw scans under
# data/jpg/ (below, intentionally unversioned: ~3.6 GB, with single .xcf masters
# well over GitHub's file limit). A clean CI checkout therefore cannot rebuild them,
# so committing them is what keeps the repo self-contained and auto-deployable.
# Public-domain source. Regenerate them locally only when the master changes.

# raw master + source images — large; Biblioteca Virtual de Defensa (CC BY 4.0), not versioned
data/jpg/
# 1785 cartela L/R column crops — derived from data/jpg/ for the Claude-vision OCR,
# regenerable with web/scripts/crop-cartelles.mjs. The OCR result (extract.json) IS versioned.
data/cartelles-1785/crops/
# copyrighted PDFs
data/pdf/

# NGIB gazetteer corpus — large, regenerable with scripts/toponims/ngib-fetch.mjs
data/toponims/ngib/llocs.json

# mapKurator: model weights + input/output tiles (large, regenerable)
data/toponims/mapkurator/
# third-party spotter clone (re-cloned by run.sh)
scripts/toponims/mapkurator/vendor/

# per-sheet review tool + GCP-build intermediates (regenerable; gcps-<q>.json IS versioned)
data/toponims/*/review-crops/
data/toponims/*/review-data.json
data/toponims/*/gcp-crops/
data/toponims/*/gcp-dots.json
data/toponims/*/*-overlay.png

# local backups of superseded curation
*.superseded

# review-server atomic-write artefacts (rolling .bak + temp on every save)
data/toponims/*/curation.json.bak
data/toponims/*/curation.json.tmp

# research PDFs about the map — local reference only, do NOT upload
data/pdf/
